{
  // A Codespace (or any dev container) that runs the agent and its compose
  // stack. 16 GB because the whole stack is ~6-7.5 GB and Docker needs room on
  // top; a 2-core / 8 GB machine runs the same profiles a laptop does.
  "name": "reference-agent",
  // The plain base, not devcontainers/python: that image ships a Yarn apt
  // source whose signing key has expired, so docker-in-docker's apt-get fails
  // and Codespaces falls back to a recovery container. uv installs Python 3.12.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Read by compose for the LiteLLM proxy only; the agent never holds it.
  // Set it once under GitHub > Settings > Codespaces > Secrets.
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Groq key for the LiteLLM proxy (needed only for --real)",
      "documentationUrl": "https://console.groq.com/keys"
    }
  },
  // Private by default. Never make these public: .env holds local-only secrets.
  "forwardPorts": [8077, 8080, 4000, 8100, 9000, 3100, 3000, 3001, 7233],
  "portsAttributes": {
    "8077": { "label": "agent", "onAutoForward": "notify" },
    "8080": { "label": "keycloak", "onAutoForward": "silent" },
    "4000": { "label": "litellm", "onAutoForward": "silent" },
    "8100": { "label": "saleor api", "onAutoForward": "silent" },
    "9000": { "label": "saleor dashboard", "onAutoForward": "silent" },
    "3100": { "label": "chatwoot", "onAutoForward": "silent" },
    "3000": { "label": "langfuse", "onAutoForward": "silent" },
    "3001": { "label": "grafana", "onAutoForward": "silent" },
    "7233": { "label": "temporal", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
