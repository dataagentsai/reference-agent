{
  "realm": "support",
  "displayName": "Support agent (local)",
  "enabled": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "orders:read",
        "description": "coarse scope, emitted in scp"
      },
      {
        "name": "orders:write",
        "description": "coarse scope, emitted in scp"
      },
      {
        "name": "returns:write",
        "description": "coarse scope, emitted in scp"
      },
      {
        "name": "escalations:read",
        "description": "coarse scope, emitted in scp"
      },
      {
        "name": "escalations:review",
        "description": "coarse scope, emitted in scp"
      },
      {
        "name": "customer",
        "description": "a store customer",
        "composite": true,
        "composites": {
          "realm": [
            "orders:read",
            "orders:write",
            "returns:write"
          ]
        }
      },
      {
        "name": "reviewer",
        "description": "works the escalation desk",
        "composite": true,
        "composites": {
          "realm": [
            "escalations:read",
            "escalations:review"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-support",
    "description": "nothing by default",
    "composite": false
  },
  "clientScopes": [
    {
      "name": "support-session",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "customer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        },
        {
          "name": "scp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "scp",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience support-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "support-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "order-system-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "audience order-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-system",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "support-chat",
      "name": "Customer chat (public)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8077/*",
        "http://127.0.0.1:8077/*"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "support-session"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "support-agent",
      "name": "The support agent (service)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUPPORT_AGENT_CLIENT_SECRET:local-dev-only-agent-secret}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "support-session"
      ],
      "optionalClientScopes": [
        "order-system-audience"
      ]
    },
    {
      "clientId": "support-approvals",
      "name": "The approval workflow (service)",
      "description": "Carries out what a colleague granted. It logs in as itself, because the customer is not there an hour later, and the order system reads whose the call is from the approval it names (T-028).",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUPPORT_APPROVALS_CLIENT_SECRET:local-dev-only-approvals-secret}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "support-session",
        "order-system-audience"
      ]
    },
    {
      "clientId": "order-system",
      "name": "The order system (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${ORDER_SYSTEM_CLIENT_SECRET:local-dev-only-order-secret}",
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "support-portal",
      "name": "Customer portal (server-side session, T-026)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUPPORT_PORTAL_CLIENT_SECRET:local-dev-only-portal-secret}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8077/portal/callback",
        "http://127.0.0.1:8077/portal/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8077/portal/*##http://127.0.0.1:8077/portal/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "support-session"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "c-1042",
      "enabled": true,
      "emailVerified": true,
      "email": "c-1042@example.test",
      "firstName": "Asha",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "local-dev-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ],
      "attributes": {
        "customer_id": [
          "C-1042"
        ]
      }
    },
    {
      "username": "c-7001",
      "enabled": true,
      "emailVerified": true,
      "email": "c-7001@example.test",
      "firstName": "Canary",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "local-dev-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ],
      "attributes": {
        "customer_id": [
          "C-7001"
        ]
      }
    },
    {
      "username": "c-9999",
      "enabled": true,
      "emailVerified": true,
      "email": "c-9999@example.test",
      "firstName": "Ravi",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "local-dev-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ],
      "attributes": {
        "customer_id": [
          "C-9999"
        ]
      }
    },
    {
      "username": "desk-1",
      "enabled": true,
      "emailVerified": true,
      "email": "desk-1@example.test",
      "firstName": "Meera",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "local-dev-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reviewer"
      ]
    },
    {
      "username": "service-account-support-approvals",
      "enabled": true,
      "serviceAccountClientId": "support-approvals",
      "realmRoles": [
        "orders:read"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"customer_id\", \"displayName\": \"Store customer id\", \"validations\": {\"length\": {\"max\": 64}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
